{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "electron/**", "tests/**", "e2e/**", "scripts/**", "*.ts", "*.json", "!package-lock.json", "!**/node_modules", "!dist", "!dist-electron", "!release", "!test-results", "!playwright-report"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always", "bracketSpacing": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn",
        "useIterableCallbackReturn": { "level": "error", "options": { "checkForEach": false } }
      },
      "complexity": {
        "noCommaOperator": "off"
      },
      "a11y": {
        "useValidAnchor": "off",
        "noAutofocus": "off",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "electron/**", "scripts/**"],
      "linter": { "rules": { "suspicious": { "noFocusedTests": "off" } } }
    }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } }
}
